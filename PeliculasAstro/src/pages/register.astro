---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Crear cuenta">
  <main class="register-shell">
    <section class="register-panel" aria-labelledby="register-title">
      <div class="brand-mark" aria-hidden="true">M</div>

      <p class="eyebrow">Movie Radar</p>

      <h1 id="register-title">Crea tu cuenta</h1>

      <p class="register-intro">
        Regístrate para administrar y explorar tu catálogo de películas.
      </p>

      <form class="register-form" id="register-form" novalidate>
        <label for="username">Usuario</label>

        <input
          id="username"
          name="username"
          type="text"
          autocomplete="username"
          placeholder="Escribe tu usuario"
          required
        />

        <label for="password">Contraseña</label>

        <input
          id="password"
          name="password"
          type="password"
          autocomplete="new-password"
          placeholder="Crea una contraseña"
          required
        />

        <label for="confirm-password">Confirmar contraseña</label>

        <input
          id="confirm-password"
          name="confirm-password"
          type="password"
          autocomplete="new-password"
          placeholder="Repite tu contraseña"
          required
        />

        <p
          id="form-error"
          class="form-error"
          role="alert"
          hidden
        ></p>

        <button
          class="submit-button"
          id="submit-button"
          type="submit"
        >
          Crear cuenta
        </button>
      </form>

      <p class="login-prompt">
        ¿Ya tienes una cuenta?
        <a href="/login" class="login-link">
          Inicia sesión aquí
        </a>
      </p>

      <p class="register-note">
        Crea tu cuenta y empieza a descubrir cuáles películas realmente valen
        la pena ver.
      </p>
    </section>

    <aside
      class="register-art"
      aria-label="Colección de películas"
    >
      <div class="art-copy">
        <p class="eyebrow">Tu próxima función</p>

        <p class="art-title">
          Descubre historias que merecen ser vistas.
        </p>
      </div>
    </aside>
  </main>

  <script>
    const form = document.querySelector(
      "#register-form",
    ) as HTMLFormElement | null;

    const usernameInput = document.querySelector(
      "#username",
    ) as HTMLInputElement | null;

    const passwordInput = document.querySelector(
      "#password",
    ) as HTMLInputElement | null;

    const confirmPasswordInput = document.querySelector(
      "#confirm-password",
    ) as HTMLInputElement | null;

    const errorMessage = document.querySelector(
      "#form-error",
    ) as HTMLParagraphElement | null;

    const submitButton = document.querySelector(
      "#submit-button",
    ) as HTMLButtonElement | null;

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (
        !usernameInput ||
        !passwordInput ||
        !confirmPasswordInput ||
        !errorMessage ||
        !submitButton
      ) {
        return;
      }

      errorMessage.textContent = "";
      errorMessage.hidden = true;

      if (
        !usernameInput.value.trim() ||
        !passwordInput.value ||
        !confirmPasswordInput.value
      ) {
        errorMessage.textContent = "Completa todos los campos.";
        errorMessage.hidden = false;
        return;
      }

      if (passwordInput.value !== confirmPasswordInput.value) {
        errorMessage.textContent = "Las contraseñas no coinciden.";
        errorMessage.hidden = false;
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = "Creando cuenta...";

      try {
        // Aquí conectaremos Supabase Auth después.
        console.log("Registro:", {
          username: usernameInput.value.trim(),
          password: passwordInput.value,
        });

        // Temporalmente:
        // window.location.href = "/login";
      } catch (error) {
        errorMessage.textContent = "No fue posible crear la cuenta.";
        errorMessage.hidden = false;
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Crear cuenta";
      }
    });
  </script>

  <style>
    .register-shell {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      background: #f5f6f8;
    }

    .register-panel {
      width: 100%;
      max-width: 520px;
      margin: auto;
      padding: 50px;
    }

    .brand-mark {
      width: 60px;
      height: 60px;
      margin-bottom: 22px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
      background: #111827;
      color: #ffffff;
      font-size: 28px;
      font-weight: 800;
    }

    .eyebrow {
      margin: 0 0 8px;
      color: #2563eb;
      font-size: 13px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .register-panel h1 {
      margin: 0 0 12px;
      color: #111827;
      font-size: 38px;
      font-weight: 800;
      line-height: 1.15;
    }

    .register-intro {
      max-width: 420px;
      margin: 0 0 30px;
      color: #6b7280;
      font-size: 16px;
      line-height: 1.6;
    }

    .register-form {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .register-form label {
      margin-top: 10px;
      color: #374151;
      font-size: 14px;
      font-weight: 700;
    }

    .register-form input {
      width: 100%;
      padding: 13px 14px;
      border: 1px solid #d1d5db;
      border-radius: 8px;
      outline: none;
      background: #ffffff;
      color: #111827;
      font-size: 15px;
      transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;
      box-sizing: border-box;
    }

    .register-form input::placeholder {
      color: #9ca3af;
    }

    .register-form input:focus {
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    .form-error {
      margin: 12px 0 4px;
      padding: 11px 13px;
      border-radius: 8px;
      background: #fef2f2;
      color: #b91c1c;
      font-size: 14px;
      font-weight: 600;
    }

    .submit-button {
      width: 100%;
      margin-top: 18px;
      padding: 13px;
      border: none;
      border-radius: 8px;
      background: #2563eb;
      color: #ffffff;
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition:
        background 0.2s ease,
        transform 0.1s ease;
    }

    .submit-button:hover:not(:disabled) {
      background: #1d4ed8;
    }

    .submit-button:active:not(:disabled) {
      transform: scale(0.99);
    }

    .submit-button:disabled {
      cursor: not-allowed;
      opacity: 0.7;
    }

    .login-prompt {
      margin: 22px 0 0;
      color: #6b7280;
      font-size: 14px;
      text-align: center;
    }

    .login-link {
      padding: 0;
      border: none;
      background: transparent;
      color: #2563eb;
      font-weight: 700;
      text-decoration: none;
    }

    .login-link:hover {
      color: #1d4ed8;
      text-decoration: underline;
    }

    .register-note {
      margin: 25px 0 0;
      color: #9ca3af;
      font-size: 13px;
      line-height: 1.5;
    }

    .register-art {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 60px;
      overflow: hidden;
      background: #111827;
    }

    .register-art::before {
      content: "";
      position: absolute;
      width: 500px;
      height: 500px;
      top: -180px;
      right: -150px;
      border-radius: 50%;
      background: #2563eb;
      opacity: 0.18;
    }

    .register-art::after {
      content: "🎬";
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -55%);
      font-size: 150px;
      opacity: 0.08;
    }

    .art-copy {
      position: relative;
      z-index: 2;
      max-width: 500px;
    }

    .register-art .eyebrow {
      color: #60a5fa;
    }

    .art-title {
      margin: 0;
      color: #ffffff;
      font-size: 42px;
      font-weight: 800;
      line-height: 1.15;
    }

    @media (max-width: 800px) {
      .register-shell {
        grid-template-columns: 1fr;
      }

      .register-panel {
        max-width: 520px;
        padding: 40px 25px;
      }

      .register-art {
        display: none;
      }
    }

    @media (max-width: 500px) {
      .register-panel h1 {
        font-size: 32px;
      }
    }
  </style>
</Layout>